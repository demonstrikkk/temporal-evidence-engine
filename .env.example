# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Start the API from the REPO ROOT so this file is found:
#   set PYTHONPATH=backend && python -m uvicorn app.main:app --port 8000

# --- persistence ---
# PERSISTENCE=postgres  -> the app reads DATABASE_URL and writes real tables
# PERSISTENCE=local     -> JSONL dev store, for tests / no infrastructure
# The adapter in use is reported by GET /api/health, so a drift is visible.
PERSISTENCE=postgres
# Apply schema with:  python backend/scripts/db_migrate.py
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Only needed by the REST client; the app itself uses DATABASE_URL.
SUPABASE_URL=
SUPABASE_KEY=

# --- discovery ---
TAVILY_API_KEY=

# --- LLM chain: opencode (primary) -> groq -> gemini (fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Set false to keep a configured-but-broken Gemini key out of the ladder.
GEMINI_ENABLED=true
# Tokens/minute the Groq key may spend. Free tier is 8000. The client keeps
# its own rolling budget at or below this, so pages queue instead of 429ing.
GROQ_TPM_LIMIT=8000
# The same pacer fronts every provider the gateway can reach, and `mistral` is
# declared in bifrost\config.json. Set this when a run points at a provider with
# a different ceiling:  BIFROST_TPM_LIMIT=60000  with
# BIFROST_MODEL_JUDGE=mistral/mistral-small-latest. Unset means GROQ_TPM_LIMIT.
# BIFROST_TPM_LIMIT=60000
# One extraction page at a time keeps a free-tier install inside its token
# window. The queue wait is credited back to the page by the runner, so a
# queued page is not reported as a timeout.
EXTRACT_PAGE_CONCURRENCY=1
# Per-page ceiling, on page work rather than queue time. Raise it for a page
# whose text is split into several chunks.
EXTRACT_PAGE_TIMEOUT_S=300

# --- opencode primary generator (local server, v1 or v2) ---
# Start it with:  OPENCODE_SERVER_PASSWORD=<same value> opencode serve --port 4096
# Both wires are supported and detected automatically: a v1 server is spoken to
# through its session API, a v2 server through `/api/experimental/generate/text`.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
OPENCODE_TIMEOUT_S=240
# Pinned reader. The model travels in the request (v1 message body, v2
# `Model.Ref`), so this is actually honoured. A bare model id is preferred; the
# `opencode/<id>` form is accepted and split for you.
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# Provider id sent alongside the model id.
OPENCODE_PROVIDER_ID=opencode
# Strict reader mode: opencode is THE reader, cloud fallbacks never fire.
OPENCODE_STRICT=false

# --- OpenCode Zen gateway (one key, the whole model gateway) ---
# Get the key from `opencode auth login` (stored under provider "opencode").
# Only space-bunny-free answers on direct REST; the other free models return
# 403 FreeTierError and are reached through the OpenCode server above.
ZEN_ENABLED=true
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=space-bunny-free
ZEN_TIMEOUT_S=120
ZEN_MAX_RETRIES=2
ZEN_MAX_TOKENS=4000
# Fan-out for /api/intel/ask. Empty = all 10 free text models.
ZEN_FANOUT_CONCURRENCY=4
ZEN_FANOUT_MODELS=
# Free typed-decision judge, tried before the paid OpenRouter one.
ZEN_JEV_ENABLED=true
JEV_ZEN_MODEL=jev-1.13-free

# --- judge (Jev via OpenRouter, paid fallback) ---
TYPESAFE_API_KEY=

# --- optional fallbacks ---
JINA_API_KEY=
FEATURE_JINA=false

# --- budgets / caps (0 = unlimited where noted) ---
RUN_MAX_PAGES=30
RUN_MAX_DEPTH=2
RUN_MAX_DOMAIN_PAGES=15
SUPERVISOR_MAX_ITERATIONS=3
SUPERVISOR_MAX_QUERIES=8
RUN_CREDIT_BUDGET=0

# --- auth posture -----------------------------------------------------------
# The API gate fails closed: with API_KEY empty every request is refused.
# Uncomment ONLY for a deliberately open local instance bound to 127.0.0.1.
# ALLOW_UNAUTHENTICATED=true

# API_KEY=            # required for any non-loopback deployment

# ===========================================================================
# Temporal Evidence Engine (PS05) � the only section this product reads
# ===========================================================================

# --- Bifrost gateway: the ONLY model path ----------------------------------
BIFROST_BASE_URL=http://127.0.0.1:8080
# A virtual key, not a provider key. Bifrost only reads a key that starts with
# `sk-bf-` from the Authorization header; anything else must go on `x-bf-vk`.
# The backend sends both. The value below is defined in bifrost\config.json.
BIFROST_VIRTUAL_KEY=sk-bf-tev-local-dev
BIFROST_MODEL_EXTRACTOR=groq/openai/gpt-oss-20b
BIFROST_MODEL_JUDGE=groq/openai/gpt-oss-20b
BIFROST_MODEL_REWRITER=groq/openai/gpt-oss-20b
BIFROST_TIMEOUT_S=60
BIFROST_MAX_RETRIES=2
BIFROST_RETRY_AFTER_CAP_S=20
BIFROST_BUDGET_USD=5.00

# --- Tavily: the ONLY research path ---------------------------------------
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_MAX_URLS_PER_CLAIM=4
TAVILY_ALLOW_CRAWLER_FALLBACK=true

# --- Verifier -------------------------------------------------------------
CLAIM_MAX_PER_ANSWER=40
RESEARCH_MAX_QUERIES_PER_CLAIM=3
CACHE_MODE=read-write
# One focused re-extraction over sentences no claim covered. 0 disables the
# repair; the audit still runs and still reports the gap.
COVERAGE_MAX_REPAIR_CALLS=1
COVERAGE_MAX_TARGETS=12
# The execution trace (the run as a tree, with cost per span). Off means the run
# has no tree at all - it does not have a partial one.
TRACE_ENABLED=true
# postgres (default when DATABASE_URL is set) or local (.tev/state.json)
PERSISTENCE=local
