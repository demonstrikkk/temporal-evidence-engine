# .env (real keys — NEVER commit) + local runtime artifacts
.env
.env.local
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Run artifacts (regenerable; may contain scraped data)
outputs/
.datagoblin-local/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.env.bak-model-161920

# Visual regression output (regenerated by frontend/e2e/visual.py)
frontend/screenshots/
/docs/explain
/video/
video/datagoblin-demo/
/video/datagoblin-demo/assets/

# Edition fetch caches (rebuildable; source bytes, not evidence)
editions/*/corpus/.cache/


# Temporal Evidence Engine
/.tev/
/eval/results/
/eval/.cache/
# Per-case scratch stores written by eval/run_eval.py under eval/<case-id>/
/eval/*/state.json
/eval/*/*.lock
/frontend/dist/

# Bifrost gateway state (config store, pid, logs) — regenerated by scripts\bifrost_up.ps1
/bifrost/.data/
